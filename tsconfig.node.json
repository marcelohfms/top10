// Este projeto tambem inclui src/engine e src/data (alem de vite.config.ts e
// src/servidor) de proposito: aqui a "lib" nao tem DOM, entao qualquer uso de
// window/document que vazar para dentro da engine quebra o "tsc -b" — e o
// mesmo limite que ate agora so um grep vigiava, agora garantido em build.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "strict": true
  },
  "include": ["vite.config.ts", "src/servidor/**/*.ts", "src/engine/**/*.ts", "src/data/**/*.ts", "src/data/**/*.json"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
